<template>
  <div class="page" on:wheel="onWheel($event)" on:click="onTap" on:keydown="onKey($event)" on:longpress="castUlt">
    <div class="world" on:touchstart="onTouchStart($event)" on:touchend="onTouchEnd($event)" on:longpress="castUlt">
      <div class="ring" style="left:163px;top:163px;width:140px;height:140px;"></div>
      <div class="ring" style="left:113px;top:113px;width:240px;height:240px;"></div>
      <div class="ring" style="left:63px;top:63px;width:340px;height:340px;"></div>
      <div class="ring" style="left:13px;top:13px;width:440px;height:440px;"></div>
      <div class="vignette"></div>
      <div class="sprite" for="sp in sprites" style="{{sp}}"></div>
    </div>

    <div class="hud" if="{{hudVisible}}">
      <p class="hud-wave">WAVE {{wave}}</p>
      <p class="hud-line">SCORE {{score}}</p>
      <p class="hud-line">HP {{hp}}</p>
    </div>
    <p class="combo" if="{{comboVisible}}">x{{combo}}</p>

    <div class="banner" if="{{bannerVisible}}">
      <p class="banner-text">{{banner}}</p>
    </div>



    <div class="overlay" if="{{menuVisible}}" on:touchend="onTap">
      <p class="title">旋钮炮塔</p>
      <p class="sub">BEST WAVE {{bestWave}} · KILLS {{totalKills}}</p>
      <div class="weapon-box">
        <p class="weapon-name">{{weaponName}}</p>
        <p class="weapon-desc">{{weaponDesc}}</p>
        <p class="weapon-hint">转表冠换武器 · 点击开始</p>
        <p class="weapon-hint2">自动开火 · 双击屏幕放大招</p>
      </div>
    </div>

    <div class="overlay" if="{{upgradeVisible}}" on:touchend="onTap">
      <p class="up-title">选择升级</p>
      <div class="cards">
        <div class="card-slot">
          <div class="card-sel" if="{{sel === 0}}">
            <p class="c-name">{{c0n}}</p>
            <p class="c-desc">{{c0d}}</p>
          </div>
          <div class="card" if="{{sel !== 0}}">
            <p class="c-name">{{c0n}}</p>
            <p class="c-desc">{{c0d}}</p>
          </div>
        </div>
        <div class="card-slot">
          <div class="card-sel" if="{{sel === 1}}">
            <p class="c-name">{{c1n}}</p>
            <p class="c-desc">{{c1d}}</p>
          </div>
          <div class="card" if="{{sel !== 1}}">
            <p class="c-name">{{c1n}}</p>
            <p class="c-desc">{{c1d}}</p>
          </div>
        </div>
        <div class="card-slot">
          <div class="card-sel" if="{{sel === 2}}">
            <p class="c-name">{{c2n}}</p>
            <p class="c-desc">{{c2d}}</p>
          </div>
          <div class="card" if="{{sel !== 2}}">
            <p class="c-name">{{c2n}}</p>
            <p class="c-desc">{{c2d}}</p>
          </div>
        </div>
      </div>
      <p class="up-hint">表冠选择 · 点击确认</p>
    </div>

    <div class="overlay" if="{{overVisible}}" on:touchend="onTap">
      <p class="over-title">RUN OVER</p>
      <p class="over-line">WAVE {{overWave}}</p>
      <p class="over-line">SCORE {{overScore}}</p>
      <p class="over-line2">KILLS {{overKills}}</p>
      <p class="over-unlock" if="{{hasUnlock}}">{{unlockText}}</p>
      <p class="over-hint">点击返回</p>
    </div>

    <div class="overlay" if="{{achVisible}}" on:touchend="onTap">
      <p class="ach-title">成就 {{achCount}}/{{achTotal}}</p>
      <p class="ach-line" for="a in achLines">{{a}}</p>
      <p class="over-hint">点击返回</p>
    </div>

    <div class="toast" if="{{toastVisible}}">
      <p class="toast-text">{{toast}}</p>
    </div>
  </div>
</template>

<style>
  .page {
    width: 466px;
    height: 466px;
    background-color: #05070d;
  }
  .world {
    position: absolute;
    left: 0;
    top: 0;
    width: 466px;
    height: 466px;
    background-color: #05070d;
  }
  .ring {
    position: absolute;
    border: 1px solid #0a1a24;
    border-radius: 50%;
  }
  .vignette {
    position: absolute;
    left: 8px;
    top: 8px;
    width: 450px;
    height: 450px;
    border: 14px solid #020408;
    border-radius: 225px;
  }
  .sprite {
    position: absolute;
    border-radius: 50%;
  }
  .hud {
    position: absolute;
    left: 74px;
    top: 68px;
  }
  .hud-wave {
    font-size: 22px;
    color: #7fb8c9;
  }
  .hud-line {
    font-size: 16px;
    color: #3f6f80;
    margin-top: 1px;
  }
  .combo {
    position: absolute;
    left: 348px;
    top: 72px;
    font-size: 28px;
    color: #ffd166;
  }
  .banner {
    position: absolute;
    left: 0;
    top: 196px;
    width: 466px;
  }
  .banner-text {
    font-size: 40px;
    color: #e8eef2;
    text-align: center;
  }
  .ult {
    position: absolute;
    left: 193px;
    top: 360px;
    width: 80px;
    height: 80px;
  }
  .ult-label {
    font-size: 13px;
    color: #6f6250;
    text-align: center;
    margin-top: 33px;
  }
  .ult-ready {
    font-size: 15px;
    color: #ffd166;
  }
  .overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 466px;
    height: 466px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: #05070d;
  }
  .title {
    font-size: 44px;
    color: #e8eef2;
  }
  .sub {
    font-size: 16px;
    color: #4d7c8f;
    margin-top: 8px;
  }
  .weapon-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 26px;
  }
  .weapon-name {
    font-size: 30px;
    color: #ffd166;
  }
  .weapon-desc {
    font-size: 15px;
