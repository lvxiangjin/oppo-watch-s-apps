<template>
  <div class="page" on:click="refresh">
    <p class="brand">DEEPSEEK</p>
    <p class="label">剩余额度</p>
    <p class="amount" if="{{isShort}}">{{amount}}</p>
    <p class="amount-mid" if="{{isMid}}">{{amount}}</p>
    <p class="amount-long" if="{{isLong}}">{{amount}}</p>
    <p class="detail">{{detail}}</p>
    <p class="status">{{status}}</p>
  </div>
</template>

<style>
  .page {
    width: 466px;
    height: 466px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: #000000;
  }

  .brand {
    font-size: 24px;
    color: #4d7cff;
    margin-bottom: 10px;
  }

  .label {
    font-size: 30px;
    color: #7a7a7a;
    margin-bottom: 4px;
  }

  .amount {
    font-size: 80px;
    color: #ffffff;
  }

  .amount-mid {
    font-size: 62px;
    color: #ffffff;
  }

  .amount-long {
    font-size: 48px;
    color: #ffffff;
  }

  .detail {
    font-size: 22px;
    color: #8a8a8a;
    margin-top: 14px;
  }

  .status {
    font-size: 20px;
    color: #5f5f5f;
    margin-top: 8px;
  }
</style>

<script>
  import config from './config.js'
  import network from '@system.network'
  import storage from '@system.storage'
  import fetch from '@system.fetch'

  export default {
    data: {
      amount: '¥ --',
      detail: '',
      status: '点击刷新',
      isShort: true,
      isMid: false,
      isLong: false
    },
    timer: null,
    busy: false,

    onShow() {
      this.restoreCache()
      this.refresh()
      this.timer = setInterval(() => this.refresh(), config.refreshMs)
    },

    onHide() {
      if (this.timer) {
        clearInterval(this.timer)
        this.timer = null
      }
    },

    restoreCache() {
      try {
        const c = storage.get('cache')
        if (c && c.amount) {
          this.render(c.amount, c.detail, '缓存 · ' + this.hm(c.at))
        }
      } catch (e) {}
    },

    async refresh() {
      if (this.busy) return
      this.busy = true
      try {
        if (config.mock) {
          this.applyBalance(config.mockData)
          return
        }
        if (!config.apiKey || config.apiKey.indexOf('REPLACE') >= 0) {
          this.amount = '¥ --'
          this.detail = ''
          this.status = '未配置 API Key'
          return
        }

        let ns = null
        try {
          ns = await network.getType()
        } catch (e) {}
        if (ns && ns.online === false) {
          this.status = '无网络连接'
          return
        }

        this.status = '查询中…'
        const r = await fetch.fetch({
          url: config.apiUrl,
          method: 'GET',
          header: {
            'Authorization': 'Bearer ' + config.apiKey,
            'Accept': 'application/json'
          },
          responseType: 'json',
          timeout: config.requestTimeout
        })

        if (!r || r.code !== 200) {
          throw new Error(r && r.code === 401 ? 'Key 无效' : 'HTTP ' + (r && r.code))
        }

        let d = r.data
        if (typeof d === 'string') d = JSON.parse(d)
        this.applyBalance(d)
      } catch (e) {
        const msg = (e && e.message) ? e.message : String(e)
        this.status = (msg === '无网络连接' || msg === '无余额数据') ? msg : '查询失败 · ' + msg
        console.warn('DSBalance fail: ' + msg)
      } finally {
        this.busy = false
      }
    },

    applyBalance(d) {
      const infos = (d && d.balance_infos) || []
      if (!infos.length) throw new Error('无余额数据')

      let info = null
      for (let i = 0; i < infos.length; i++) {
        if (infos[i].currency === config.preferCurrency) info = infos[i]
      }
      if (!info) info = infos[0]

      const amount = this.money(info.total_balance)
      const detail = info.currency + ' · 充值 ' + this.money(info.topped_up_balance) +
                     ' · 赠送 ' + this.money(info.granted_balance)
      const state = d.is_available ? '可用' : '不可用'
      this.render(amount, detail, state + ' · ' + this.hm(Date.now()))

      try {
        storage.set('cache', { amount: amount, detail: detail, at: Date.now() })
      } catch (e) {}
    },

    render(amount, detail, status) {
      this.amount = amount
      this.detail = detail
      this.status = status
      const len = String(amount).length
      this.isShort = len <= 8
      this.isMid = len > 8 && len <= 10
      this.isLong = len > 10
    },

    money(v) {
      const n = Number(v)
      if (isNaN(n)) return String(v)
      return '¥' + n.toFixed(2)
    },

    hm(ts) {
      const d = new Date(ts)
      const p = n => (n < 10 ? '0' + n : '' + n)
      return p(d.getHours()) + ':' + p(d.getMinutes())
    }
  }
</script>
